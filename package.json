{
  "name": "sassuolo-history",
  "private": true,
  "version": "0.5.0",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10 <12"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c auto \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "setup": "npm run db:init && npm run import:all",
    "db:init": "tsx scripts/init-db.ts",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "data:provenance": "tsx scripts/backfill-provenance.ts",
    "import:all": "tsx scripts/import-all.ts",
    "check": "tsc --noEmit",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:supply-chain": "tsx scripts/check-supply-chain.ts",
    "check:supply-chain:audit": "tsx scripts/check-supply-chain.ts --audit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:api-contract": "tsx --test tests/admin-enhancements.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --project=chromium-desktop --update-snapshots",
    "build": "npm run check && vite build && npm run check:bundle",
    "check:bundle": "tsx scripts/check-bundle-budget.ts",
    "perf:pagination": "tsx scripts/benchmark-pagination.ts",
    "perf:archive": "tsx scripts/benchmark-final-archive.ts",
    "ops:sbom": "npm sbom --sbom-format cyclonedx > sbom.cdx.json",
    "ops:backup": "tsx scripts/export-backup.ts",
    "ops:restore-drill": "tsx scripts/restore-drill.ts",
    "ops:smoke": "tsx scripts/smoke-release.ts",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "history:bootstrap": "tsx scripts/bootstrap-history.ts",
    "history:pre-serie-a": "tsx scripts/bootstrap-pre-serie-a-squads.ts",
    "history:fbref": "tsx scripts/import-fbref-standard-archive.ts",
    "history:reconcile": "tsx scripts/reconcile-history.ts",
    "history:statbunker-player-seasons": "tsx scripts/import-statbunker-player-seasons.ts",
    "history:api-football-missing-player-seasons": "tsx scripts/import-api-football-missing-player-seasons.ts",
    "history:derive-player-seasons": "tsx scripts/derive-player-seasons-from-match-stats.ts",
    "history:verified-match-player-seasons": "tsx scripts/import-verified-match-player-seasons.ts",
    "history:derive-partial-2025-serie-a": "tsx scripts/derive-partial-2025-serie-a-player-seasons.ts",
    "history:complete-2025-26": "tsx scripts/complete-2025-26-from-match-details.ts",
    "data:audit": "tsx scripts/audit-data.ts",
    "data:audit:full": "tsx scripts/audit-data-full.ts",
    "data:registry": "tsx scripts/reconcile-registry.ts",
    "data:release": "tsx scripts/generate-data-release.ts",
    "data:release:check": "tsx scripts/generate-data-release.ts --check",
    "matches:dedupe": "tsx scripts/dedupe-football-data-matches.ts",
    "matches:dedupe:apply": "tsx scripts/dedupe-football-data-matches.ts --apply",
    "matches:clean-api-football": "tsx scripts/clean-api-football-matches.ts",
    "matches:clean-bigballs": "tsx scripts/clean-bigballs-matches.ts",
    "matches:clean-bigballs:dry": "tsx scripts/clean-bigballs-matches.ts --dry-run",
    "data:correct-europa-2016-17": "tsx scripts/correct-europa-league-2016-17.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "better-sqlite3": "13.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "lucide-react": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "recharts": "3.10.1",
    "rss-parser": "3.13.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.5.4",
    "concurrently": "10.0.4",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
