PORT=8787

# football-data.org: opzionale, usato per fixture/risultati correnti quando configurato.
FOOTBALL_DATA_API_KEY=
ENABLE_FOOTBALL_DATA=true

# API-Football (API-Sports) — fonte principale per giocatori, classifiche,
# statistiche squadra, rosa, trasferimenti e allenatore.
API_FOOTBALL_KEY=
ENABLE_API_FOOTBALL=true

# Opzionale. Lascialo vuoto: al primo "Test API" il progetto cerca Sassuolo
# con /teams?search=Sassuolo e salva l'ID in SQLite.
API_FOOTBALL_SASSUOLO_TEAM_ID=

ENABLE_THESPORTSDB=true
ENABLE_RSS=true

# KickoffAPI v1 — fonte principale per partite e dettagli match.
# Crea una key su kickoffapi.com e tienila SOLO nel backend.
KICKOFF_API_KEY=
ENABLE_KICKOFF_API=true

# Opzionali: normalmente non serve modificarli. Gli ID v1 coincidono con i
# legacy ID API-Football; per Serie A/Sassuolo i valori verificati sono 135/488.
KICKOFF_SERIE_A_LEAGUE_ID=135
KICKOFF_SASSUOLO_TEAM_ID=488

# Protezioni quota. Il piano Free ha una quota giornaliera limitata:
# l'import stagionale è riprendibile e salta ciò che è già sincronizzato.
KICKOFF_MAX_REQUESTS_PER_RUN=80
KICKOFF_SMART_UPDATE_MAX_REQUESTS=20
KICKOFF_QUOTA_SAFETY=5
